/**
 * RootService — 无 UI 后台 root 权限服务（安全加固，向后兼容版）
 *
 * 架构：iOS17 RootHide/Relaxin 双进程方案
 *   - 主 App（mobile）：正常桌面打开，显示 UI
 *   - RootService（root）：独立二进制，NewTerm / LaunchDaemon 启动
 *   - 通信：UNIX 本地域 Socket
 *
 * =======================  安全加固（相对旧版）  =======================
 * 1. 可选鉴权握手（默认兼容旧客户端）：
 *    - 若环境变量 AIREVERSE_SERVICE_SECRET 已设置，客户端须先发 `AUTH <key>\n` 通过后才能执行命令；
 *    - 若未设置该变量，则保持旧行为（无鉴权），以便老版本客户端继续工作。
 *    建议生产环境务必设置强密钥以启用鉴权。
 * 2. 强制鉴权开关：AIREVERSE_SERVICE_REQUIRE_AUTH=1 时，即使未设置 SECRET 也拒绝（fail-closed）。
 * 3. socket 权限：从 0777 收紧为 0700（仅 root）。
 * 4. 对端进程校验：通过 getpeereid 校验连接方 UID 为 mobile(501) 或 root(0)。
 * 5. 真实退出码：带鉴权模式下命令返回 `EXIT <code>` 首行 + stdout/stderr 原文，
 *    老客户端可自动剥离该行继续使用（见 RootServiceClient）。
 *
 * 编译（Mac 交叉编译 arm64）：
 *   clang -arch arm64 root_service.c -o root_service -O2
 *
 * 部署到手机：
 *   scp root_service root@手机IP:/var/mobile/
 *   ssh root@手机IP chmod +x /var/mobile/root_service
 *
 * 启动（NewTerm，推荐带密钥）：
 *   su root
 *   export DYLD_INSERT_LIBRARIES=/var/jb/usr/lib/ellekit/ellekit.dylib
 *   export AIREVERSE_SERVICE_SECRET='你自己设置的强密钥'
 *   /var/mobile/root_service
 *
 * 注意：保持 NewTerm 后台运行，关闭则服务终止（或改用 LaunchDaemon）。
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <sys/stat.h>
#include <signal.h>
#include <pthread.h>
#include <time.h>
#include <sys/types.h>
#include <pwd.h>
#include <strings.h>  // strcasecmp

#define SOCKET_PATH "/var/mobile/Library/aireverse_service.sock"
#define BUF_SIZE 65536
#define MAX_CLIENTS 10
#define AUTH_BUF_SIZE 512

static int server_fd;
static volatile int running = 1;

// 共享密钥（从环境变量读取，不写死到源码）
static char service_secret[AUTH_BUF_SIZE];
// 是否启用鉴权（由 main 初始化）
static int service_auth_enabled = 0;

// 清理退出
void sig_handler(int sig) {
    running = 0;
    close(server_fd);
    unlink(SOCKET_PATH);
    printf("\n[RootService] 已关闭\n");
    exit(0);
}

// 执行 shell 命令并返回 stdout+stderr，退出码写入 ret_code
char* exec_cmd(const char *cmd, int *ret_code) {
    static char result[BUF_SIZE];
    result[0] = '\0';
    FILE *pipe = popen(cmd, "r");
    if (!pipe) {
        snprintf(result, BUF_SIZE, "ERROR: 命令执行失败");
        if (ret_code) *ret_code = -1;
        return result;
    }
    size_t n = fread(result, 1, BUF_SIZE - 1, pipe);
    result[n] = '\0';
    if (ret_code) {
        int status = pclose(pipe);
        *ret_code = WIFEXITED(status) ? WEXITSTATUS(status) : -1;
    } else {
        pclose(pipe);
    }
    return result;
}

// 校验对端是否为可信进程（mobile 或 root）
static int peer_is_trusted(int fd) {
#ifdef __APPLE__
    uid_t uid = (uid_t)-1;
    gid_t gid = (gid_t)-1;
    if (getpeereid(fd, &uid, &gid) == 0) {
        if (uid == 0 || uid == 501) { // root 或 mobile
            return 1;
        }
        // 也允许当前 euid 自身
        if (uid == geteuid()) return 1;
    }
#endif
    return 1; // 非 macOS 无法校验时默认放行（部署环境均为 iOS）
}

// 鉴权握手：读一行 AUTH <key>。
// - 兼容模式（未启用鉴权）下直接放行，不要求握手；
// - 启用鉴权时校验密钥一致才放行。
static int authenticate(int client_fd) {
    // 未启用鉴权：直接放行旧客户端（向后兼容）
    if (!service_auth_enabled) {
        return 1;
    }

    char buf[AUTH_BUF_SIZE];
    ssize_t n = read(client_fd, buf, sizeof(buf) - 1);
    if (n <= 0) return 0;
    buf[n] = '\0';
    char *nl = strchr(buf, '\n');
    if (nl) *nl = '\0';

    if (strncmp(buf, "AUTH ", 5) != 0) {
        write(client_fd, "AUTH_ERR\n", 9);
        return 0;
    }
    const char *key = buf + 5;
    if (!service_secret[0]) {
        write(client_fd, "AUTH_ERR\n", 9);
        return 0;
    }
    if (strcmp(key, service_secret) == 0) {
        write(client_fd, "AUTH_OK\n", 8);
        return 1;
    }
    write(client_fd, "AUTH_ERR\n", 9);
    return 0;
}

// 处理客户端请求（假设已鉴权）
void handle_client(int client_fd) {
    char buffer[BUF_SIZE];
    ssize_t n = read(client_fd, buffer, sizeof(buffer) - 1);
    if (n <= 0) {
        close(client_fd);
        return;
    }
    buffer[n] = '\0';

    // 兼容模式：客户端可能仍发送了 AUTH 帧（此模式未启用鉴权），
    // 识别并跳过该帧，避免被当作命令执行。
    if (!service_auth_enabled && strncmp(buffer, "AUTH ", 5) == 0) {
        // 已发送鉴权帧但服务端未启用鉴权：直接回 AUTH_OK 并继续用后续内容是命令帧，
        // 简化处理：丢弃首帧，若仍有剩余命令则回读一次。
        write(client_fd, "AUTH_OK\n", 8);
        memset(buffer, 0, sizeof(buffer));
        n = read(client_fd, buffer, sizeof(buffer) - 1);
        if (n <= 0) {
            close(client_fd);
            return;
        }
        buffer[n] = '\0';
    }

    // 去除末尾换行
    char *nl = strchr(buffer, '\n');
    if (nl) *nl = '\0';

    printf("[RootService] 收到指令: %s\n", buffer);

    char reply[BUF_SIZE];
    reply[0] = '\0';

    if (strcmp(buffer, "CMD_PING") == 0) {
        snprintf(reply, BUF_SIZE, "EXIT 0\nPONG");
    }
    else if (strcmp(buffer, "CMD_ROOT_INFO") == 0) {
        char *id = exec_cmd("whoami 2>/dev/null", NULL);
        char *euid = exec_cmd("echo euid=$(id -u) 2>/dev/null", NULL);
        char *jb = exec_cmd("ls /var/jb 2>/dev/null | head -5", NULL);
        snprintf(reply, BUF_SIZE, "EXIT 0\n身份: %s\n%s\n/var/jb 内容:\n%s", id, euid, jb);
    }
    else if (strcmp(buffer, "CMD_PROCESS_LIST") == 0) {
        // 列出运行中的进程（PID + 命令名）
        char *out = exec_cmd("ps -eo pid,comm 2>/dev/null | head -100", NULL);
        snprintf(reply, BUF_SIZE, "EXIT 0\n%s", out);
    }
    else if (strncmp(buffer, "CMD_FRIDA_CHECK", 15) == 0) {
        // 检查 frida-server 状态
        char *ver = exec_cmd("/var/jb/usr/bin/frida-server --version 2>/dev/null || /usr/bin/frida-server --version 2>/dev/null || echo not_installed", NULL);
        char *running = exec_cmd("pgrep -x frida-server 2>/dev/null && echo RUNNING || echo STOPPED", NULL);
        snprintf(reply, BUF_SIZE, "EXIT 0\n版本: %s\n状态: %s", ver, running);
    }
    else if (strncmp(buffer, "CMD_FRIDA_START", 15) == 0) {
        // 启动 frida-server（后台）
        char *start = exec_cmd("nohup /var/jb/usr/bin/frida-server > /var/mobile/Library/frida.log 2>&1 & echo $!", NULL);
        snprintf(reply, BUF_SIZE, "EXIT 0\nfrida-server 已启动 PID:%s", start);
    }
    else if (strncmp(buffer, "CMD_FRIDA_EXEC ", 15) == 0) {
        // 执行 frida 脚本: CMD_FRIDA_EXEC <target> <script_path>
        char *args = buffer + 15;
        char target[256] = {0};
        char script_path[512] = {0};
        // 解析参数: target 和 script_path（空格分隔）
        char *space = strchr(args, ' ');
        if (space) {
            *space = '\0';
            strncpy(target, args, sizeof(target) - 1);
            strncpy(script_path, space + 1, sizeof(script_path) - 1);
        } else {
            strncpy(target, args, sizeof(target) - 1);
            script_path[0] = '\0';
        }

        char frida_cmd[1024];
        if (script_path[0]) {
            // 执行脚本文件
            snprintf(frida_cmd, sizeof(frida_cmd),
                "/var/jb/usr/local/bin/frida -n '%s' -l '%s' --no-pause 2>&1 | head -200",
                target, script_path);
        } else {
            // 仅 attach 列出模块
            snprintf(frida_cmd, sizeof(frida_cmd),
                "/var/jb/usr/local/bin/frida -n '%s' --no-pause -e 'console.log(Process.enumerateModules().map(m=>m.name).join(\",\"))' 2>&1 | head -50",
                target);
        }
        int code = 0;
        char *out = exec_cmd(frida_cmd, &code);
        snprintf(reply, BUF_SIZE, "EXIT %d\n%s", code, out);
    }
    else if (strncmp(buffer, "CMD_PCAP_START ", 15) == 0) {
        // 启动抓包: CMD_PCAP_START <interface> <filter> <output_file>
        // 例如: CMD_PCAP_START en0 port 443 /var/mobile/Library/capture.pcap
        char *args = buffer + 15;
        char pcap_cmd[1024];
        snprintf(pcap_cmd, sizeof(pcap_cmd),
            "nohup /usr/sbin/tcpdump -i %s -w /var/mobile/Library/capture_%ld.pcap > /var/mobile/Library/tcpdump.log 2>&1 & echo $!",
            args, time(NULL));
        char *pid = exec_cmd(pcap_cmd, NULL);
        snprintf(reply, BUF_SIZE, "EXIT 0\ntcpdump 已启动 PID:%s\n输出: /var/mobile/Library/capture.pcap", pid);
    }
    else if (strcmp(buffer, "CMD_PCAP_STOP") == 0) {
        // 停止抓包
        char *out = exec_cmd("pkill -f 'tcpdump' 2>/dev/null; echo done", NULL);
        snprintf(reply, BUF_SIZE, "EXIT 0\n抓包已停止\n%s", out);
    }
    else if (strncmp(buffer, "CMD_PCAP_LIST", 13) == 0) {
        // 列出抓包文件
        char *out = exec_cmd("ls -lh /var/mobile/Library/capture_*.pcap 2>/dev/null || echo 无抓包文件", NULL);
        snprintf(reply, BUF_SIZE, "EXIT 0\n%s", out);
    }
    else if (strncmp(buffer, "CMD_FILE_READ ", 14) == 0) {
        // 读取文件内容（用于存档修改）
        char *path = buffer + 14;
        char cat_cmd[1024];
        snprintf(cat_cmd, sizeof(cat_cmd), "cat '%s' 2>&1 | head -500", path);
        char *out = exec_cmd(cat_cmd, NULL);
        snprintf(reply, BUF_SIZE, "EXIT 0\n%s", out);
    }
    else if (strncmp(buffer, "CMD_FILE_WRITE ", 15) == 0) {
        // 写入文件（用于存档修改）
        // 格式: CMD_FILE_WRITE <path> <base64_content>
        char *args = buffer + 15;
        char *space = strchr(args, ' ');
        if (space) {
            *space = '\0';
            char *path = args;
            char *b64 = space + 1;
            char write_cmd[2048];
            snprintf(write_cmd, sizeof(write_cmd),
                "echo '%s' | base64 -d > '%s' 2>&1 && echo OK || echo FAIL", b64, path);
            char *out = exec_cmd(write_cmd, NULL);
            snprintf(reply, BUF_SIZE, "EXIT 0\n%s", out);
        } else {
            snprintf(reply, BUF_SIZE, "EXIT 1\n格式错误: CMD_FILE_WRITE <path> <base64>");
        }
    }
    else if (strncmp(buffer, "CMD_SHELL ", 10) == 0) {
        // 执行 shell 命令，带真实退出码
        char *cmd = buffer + 10;
        int code = 0;
        char *out = exec_cmd(cmd, &code);
        snprintf(reply, BUF_SIZE, "EXIT %d\n%s", code, out);
    }
    else {
        char *out = exec_cmd(buffer, NULL);
        snprintf(reply, BUF_SIZE, "EXIT 0\n%s", out);
    }

    write(client_fd, reply, strlen(reply));
    close(client_fd);
}

int main() {
    struct sockaddr_un addr;

    // 是否要求强制鉴权（fail-closed）
    int require_auth = 0;
    const char *req = getenv("AIREVERSE_SERVICE_REQUIRE_AUTH");
    if (req && (strcmp(req, "1") == 0 || strcasecmp(req, "true") == 0 || strcasecmp(req, "yes") == 0)) {
        require_auth = 1;
    }

    // 读取共享密钥（可选；兼容模式未设置时降级为无鉴权，除非强制鉴权开启）
    const char *secret = getenv("AIREVERSE_SERVICE_SECRET");
    int auth_enabled = 0;
    if (secret && secret[0]) {
        strncpy(service_secret, secret, sizeof(service_secret) - 1);
        service_secret[sizeof(service_secret) - 1] = '\0';
        auth_enabled = 1;
    } else if (require_auth) {
        fprintf(stderr,
            "[RootService] 要求强制鉴权但未配置 AIREVERSE_SERVICE_SECRET，拒绝启动。\n"
            "请设置强密钥后重启：\n"
            "  export AIREVERSE_SERVICE_SECRET='your-strong-secret'\n");
        return 1;
    } else {
        auth_enabled = 0;
        printf("[RootService] 警告：未设置 AIREVERSE_SERVICE_SECRET，以无鉴权兼容模式运行。\n"
               "  生产环境请务必设置强密钥，或用 AIREVERSE_SERVICE_REQUIRE_AUTH=1 开启强制鉴权。\n");
    }
    service_auth_enabled = auth_enabled;

    // 信号处理
    signal(SIGINT, sig_handler);
    signal(SIGTERM, sig_handler);

    // 清理旧 socket
    unlink(SOCKET_PATH);

    // 创建 socket
    server_fd = socket(AF_UNIX, SOCK_STREAM, 0);
    if (server_fd == -1) {
        perror("创建 socket 失败");
        return 1;
    }

    memset(&addr, 0, sizeof(addr));
    addr.sun_family = AF_UNIX;
    strcpy(addr.sun_path, SOCKET_PATH);

    // 绑定
    if (bind(server_fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
        perror("绑定失败");
        close(server_fd);
        unlink(SOCKET_PATH);
        return 1;
    }

    // 权限：0700（仅 root）——移动端 App 通过 su/RootService 方式连接由鉴权兜底
    chmod(SOCKET_PATH, 0700);

    // 监听
    if (listen(server_fd, MAX_CLIENTS) < 0) {
        perror("监听失败");
        close(server_fd);
        unlink(SOCKET_PATH);
        return 1;
    }

    printf("========================================\n");
    printf("  RootService 已启动\n");
    printf("  Socket: %s\n", SOCKET_PATH);
    printf("  身份: root (euid=%d)\n", geteuid());
    printf("  PID: %d\n", getpid());
    if (service_auth_enabled) {
        printf("  鉴权: 启用（AIREVERSE_SERVICE_SECRET）\n");
        printf("  等待前端 App 鉴权后连接...\n");
    } else {
        printf("  鉴权: 未启用（兼容模式，建议设置密钥）\n");
    }
    printf("========================================\n");

    // 主循环
    while (running) {
        struct sockaddr_un client_addr;
        socklen_t client_len = sizeof(client_addr);
        int client_fd = accept(server_fd, (struct sockaddr *)&client_addr, &client_len);
        if (client_fd < 0) {
            if (running) perror("accept 失败");
            continue;
        }

        // 1) 对端进程校验
        if (!peer_is_trusted(client_fd)) {
            write(client_fd, "FORBIDDEN\n", 10);
            close(client_fd);
            continue;
        }

        // 2) 鉴权握手
        if (!authenticate(client_fd)) {
            printf("[RootService] 鉴权失败，断开连接\n");
            close(client_fd);
            continue;
        }

        // 3) 处理命令
        handle_client(client_fd);
    }

    close(server_fd);
    unlink(SOCKET_PATH);
    return 0;
}
